---
const year = new Date().getFullYear();
---
<footer class="border-t border-white/10 bg-brand-black">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3">
        <img src="/logo.jpg" alt="Web Guy Nick" width="44" height="44" class="h-11 w-11 rounded-full" loading="lazy" />
        <div>
          <div class="font-semibold text-white">Web Guy Nick LLC</div>
          <div class="text-sm text-slate-400">Your Website Should Be Your Best Salesperson.</div>
        </div>
      </div>
      <p class="mt-4 max-w-md text-sm text-slate-400">
        Conversion-led websites, hosting, and ongoing maintenance for small businesses.
      </p>
      <div class="mt-4 text-sm text-slate-400">
        <a href="mailto:info@webguynick.com" class="hover:text-brand-accent">info@webguynick.com</a>
        <span class="mx-2">·</span>
        <a href="tel:+19515360028" class="hover:text-brand-accent">(951) 536-0028</a>
      </div>
    </div>

    <div>
      <div class="text-sm font-semibold text-white">Site</div>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        <li><a href="/services" class="hover:text-brand-accent">Services</a></li>
        <li><a href="/hosting" class="hover:text-brand-accent">Hosting</a></li>
        <li><a href="/resources" class="hover:text-brand-accent">Resources</a></li>
        <li><a href="/articles" class="hover:text-brand-accent">Articles</a></li>
        <li><a href="/contact" class="hover:text-brand-accent">Contact</a></li>
      </ul>
    </div>

    <div>
      <div class="text-sm font-semibold text-white">Legal</div>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        <li><a href="/privacy" class="hover:text-brand-accent">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-brand-accent">Terms &amp; Conditions</a></li>
        <li><a href="/disclosure" class="hover:text-brand-accent">Affiliate Disclosure</a></li>
      </ul>

      <div class="mt-6 flex gap-3 text-slate-400">
        <a aria-label="Facebook" href="https://facebook.com/webguynickllc" class="hover:text-brand-accent">FB</a>
        <a aria-label="Instagram" href="https://instagram.com/webguynickllc" class="hover:text-brand-accent">IG</a>
        <a aria-label="LinkedIn" href="https://linkedin.com/company/webguynickllc" class="hover:text-brand-accent">LI</a>
        <a aria-label="X" href="https://x.com/webguyeth" class="hover:text-brand-accent">X</a>
        <a aria-label="TikTok" href="https://tiktok.com/@webguynick1" class="hover:text-brand-accent">TT</a>
      </div>
    </div>
  </div>

  <div class="border-t border-white/5 py-5 text-center text-xs text-slate-500">
    © {year} Web Guy Nick LLC. All rights reserved.
  </div>
</footer>
