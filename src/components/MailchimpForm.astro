---
interface Props {
  variant?: 'inline' | 'card';
  headline?: string;
  subhead?: string;
}
const {
  variant = 'card',
  headline = 'Get small-business web tips in your inbox',
  subhead = 'One short email a week. Unsubscribe anytime.',
} = Astro.props;

// TODO: Replace action URL with your Mailchimp embedded form action.
// Mailchimp → Audience → Signup forms → Embedded forms → copy the <form action="...">
const MAILCHIMP_ACTION = import.meta.env.PUBLIC_MAILCHIMP_ACTION
  || 'https://webguynick.us1.list-manage.com/subscribe/post?u=REPLACE_U&id=REPLACE_ID&f_id=REPLACE_F';
const MAILCHIMP_HIDDEN_BOT = import.meta.env.PUBLIC_MAILCHIMP_BOT_NAME
  || 'b_REPLACE_U_REPLACE_ID';
---
<section class:list={['w-full', variant === 'card' ? 'card' : '']}>
  <div class="max-w-xl">
    <h3 class="text-2xl font-semibold text-white">{headline}</h3>
    <p class="mt-2 text-slate-300">{subhead}</p>
    <form
      action={MAILCHIMP_ACTION}
      method="post"
      target="_blank"
      novalidate
      class="mt-5 flex flex-col gap-3 sm:flex-row"
    >
      <label class="sr-only" for="mce-EMAIL">Email</label>
      <input
        id="mce-EMAIL"
        name="EMAIL"
        type="email"
        required
        placeholder="you@yourbusiness.com"
        class="flex-1 rounded-lg border border-white/15 bg-white/5 px-4 py-3 text-white placeholder:text-slate-500 focus:border-brand-accent focus:outline-none"
      />
      <!-- Honeypot: keep this visually hidden -->
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name={MAILCHIMP_HIDDEN_BOT} tabindex="-1" value="" />
      </div>
      <button type="submit" class="btn-primary justify-center">Subscribe</button>
    </form>
    <p class="mt-3 text-xs text-slate-500">By subscribing you agree to our <a href="/privacy" class="underline hover:text-brand-accent">Privacy Policy</a>.</p>
  </div>
</section>
