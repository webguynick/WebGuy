---
// Matrix-style digital rain effect — subtle, GPU-friendly, respects prefers-reduced-motion
// Words are themed for a small-business web designer
---
<canvas
  id="matrix-rain"
  class="pointer-events-none absolute inset-0 h-full w-full"
  aria-hidden="true"
></canvas>

<script is:inline>
  (function () {
    const canvas = document.getElementById('matrix-rain');
    if (!canvas) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    // Brand-themed glyphs: code symbols + small biz keywords
    const glyphs = '01<>{}/\\$=#*+-•◆○●▪▫░'.split('');
    const words = ['SEO', 'CSS', 'AI', 'CTR', 'CRO', 'WP', 'CDN', 'SSL', 'API', 'UX', 'UI', 'DNS', 'TTL', 'LCP', 'CWV'];

    let columns = 0;
    let drops = [];
    const fontSize = 14;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.floor(rect.width * dpr);
      canvas.height = Math.floor(rect.height * dpr);
      ctx.scale(dpr, dpr);
      columns = Math.floor(rect.width / fontSize);
      drops = Array.from({ length: columns }, () => ({
        y: Math.random() * -50,
        speed: 0.25 + Math.random() * 0.6,
        useWord: Math.random() < 0.08,
      }));
    }

    function draw() {
      const rect = canvas.getBoundingClientRect();
      // Soft trailing fade — gives the falling effect
      ctx.fillStyle = 'rgba(8, 9, 12, 0.08)';
      ctx.fillRect(0, 0, rect.width, rect.height);
      ctx.font = `${fontSize}px ui-monospace, SFMono-Regular, Menlo, monospace`;

      for (let i = 0; i < drops.length; i++) {
        const d = drops[i];
        const x = i * fontSize;
        const y = d.y * fontSize;

        // Head: brand-accent green-cyan
        ctx.fillStyle = 'rgba(96, 235, 175, 0.55)';
        const head = d.useWord && Math.random() < 0.02
          ? words[Math.floor(Math.random() * words.length)]
          : glyphs[Math.floor(Math.random() * glyphs.length)];
        ctx.fillText(head, x, y);

        // Trailing dim
        ctx.fillStyle = 'rgba(96, 235, 175, 0.18)';
        const tail = glyphs[Math.floor(Math.random() * glyphs.length)];
        ctx.fillText(tail, x, y - fontSize * 2);

        d.y += d.speed;
        if (y > rect.height && Math.random() > 0.975) {
          d.y = Math.random() * -20;
          d.speed = 0.25 + Math.random() * 0.6;
          d.useWord = Math.random() < 0.08;
        }
      }
      raf = requestAnimationFrame(draw);
    }

    let raf;
    function start() {
      cancelAnimationFrame(raf);
      resize();
      draw();
    }

    // Pause when off-screen for perf
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) start();
        else cancelAnimationFrame(raf);
      });
    }, { threshold: 0 });
    io.observe(canvas);

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(start, 150);
    });

    start();
  })();
</script>

<style>
  #matrix-rain {
    /* Subtle so it never competes with text */
    opacity: 0.35;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }
</style>
