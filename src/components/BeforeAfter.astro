---
interface Props {
  title: string;
  client: string;
  beforeLabel?: string;
  afterLabel?: string;
  metrics: Array<{ label: string; before: string; after: string }>;
  /** Optional accent color for "after" badges */
  accent?: string;
}
const {
  title,
  client,
  beforeLabel = 'Before',
  afterLabel = 'After',
  metrics,
  accent = '#60a5fa',
} = Astro.props;
const id = 'ba-' + Math.random().toString(36).slice(2, 8);
---
<section class="ba relative" data-ba data-ba-id={id}>
  <div class="mx-auto max-w-5xl px-5 py-20">
    <div class="mb-8 flex items-center justify-between gap-6">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">{client}</div>
        <h3 class="mt-1 text-3xl font-bold text-white md:text-4xl">{title}</h3>
      </div>
      <div class="ba-pill hidden md:flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs">
        <span class="ba-pill-before text-slate-400">{beforeLabel}</span>
        <span class="ba-pill-bar h-1 w-12 rounded-full bg-white/15 relative overflow-hidden">
          <span class="ba-pill-fill absolute inset-y-0 left-0 w-0 bg-brand-accent"></span>
        </span>
        <span class="ba-pill-after text-white">{afterLabel}</span>
      </div>
    </div>

    <div class="ba-stack relative grid grid-cols-1 gap-4 md:grid-cols-2">
      {metrics.map((m, i) => (
        <div class="ba-card card !p-6" style={`--i:${i}`}>
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">{m.label}</div>
          <div class="mt-3 grid grid-cols-2 gap-3">
            <div>
              <div class="text-[11px] text-slate-500 uppercase">{beforeLabel}</div>
              <div class="ba-before mt-1 text-2xl font-semibold text-slate-300 line-through decoration-red-500/60">{m.before}</div>
            </div>
            <div>
              <div class="text-[11px] text-slate-500 uppercase">{afterLabel}</div>
              <div class="ba-after mt-1 text-3xl font-extrabold" style={`color:${accent}`}>{m.after}</div>
            </div>
          </div>
          <div class="ba-bar mt-4 h-1 rounded-full bg-white/10 overflow-hidden">
            <div class="ba-bar-fill h-full w-0 rounded-full" style={`background:${accent}`}></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Scroll-driven progressive reveal where supported. Falls back to IntersectionObserver below. */
  @supports (animation-timeline: view()) {
    .ba-card {
      opacity: 0;
      transform: translateY(28px);
      animation: ba-rise both;
      animation-timeline: view();
      animation-range: entry 5% cover 35%;
    }
    .ba-bar-fill {
      animation: ba-fill both;
      animation-timeline: view();
      animation-range: entry 20% cover 60%;
    }
    .ba-pill-fill {
      animation: ba-fill both;
      animation-timeline: view();
      animation-range: entry 0% cover 80%;
    }
  }
  @keyframes ba-rise {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes ba-fill {
    to { width: 100%; }
  }
  /* Reduced motion: show final state immediately */
  @media (prefers-reduced-motion: reduce) {
    .ba-card { opacity: 1 !important; transform: none !important; animation: none !important; }
    .ba-bar-fill, .ba-pill-fill { width: 100% !important; animation: none !important; }
  }
</style>

<script is:inline>
  // Fallback for browsers without animation-timeline support (Safari ≤ 17, etc.)
  (function () {
    if (CSS.supports('animation-timeline: view()')) return;
    const observer = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const root = e.target;
        root.querySelectorAll('.ba-card').forEach((el, i) => {
          el.style.transition = 'opacity 600ms ease-out, transform 600ms ease-out';
          el.style.transitionDelay = (i * 80) + 'ms';
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        });
        root.querySelectorAll('.ba-bar-fill, .ba-pill-fill').forEach((el, i) => {
          el.style.transition = 'width 900ms ease-out';
          el.style.transitionDelay = (200 + i * 60) + 'ms';
          el.style.width = '100%';
        });
        observer.unobserve(root);
      }
    }, { threshold: 0.15 });
    document.querySelectorAll('[data-ba]').forEach((el) => {
      el.querySelectorAll('.ba-card').forEach((c) => {
        c.style.opacity = '0';
        c.style.transform = 'translateY(28px)';
      });
      observer.observe(el);
    });
  })();
</script>
