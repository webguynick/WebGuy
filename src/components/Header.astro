---
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/care-plans', label: 'Care Plans' },
  { href: '/hosting-plans', label: 'Hosting' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/articles', label: 'Articles' },
  { href: '/game', label: '🎮 Game' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b border-white/10 bg-brand-black/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3">
    <a href="/" class="flex items-center gap-3 font-semibold">
      <img src="/logo.jpg" alt="Web Guy Nick" width="36" height="36" class="h-9 w-9 rounded-full" loading="eager" />
      <span class="text-white">Web Guy Nick</span>
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-6 text-sm">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition hover:text-brand-accent',
            path.startsWith(item.href) ? 'text-brand-accent' : 'text-slate-300',
          ]}
        >{item.label}</a>
      ))}
      <a href="/contact" class="btn-primary text-sm px-4 py-2">Get a Quote</a>
    </nav>

    <button
      id="nav-toggle"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/15 text-white"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-brand-black">
    <nav class="mx-auto max-w-7xl px-5 py-4 flex flex-col gap-3 text-sm">
      {nav.map((item) => (
        <a href={item.href} class="py-2 text-slate-200 hover:text-brand-accent">{item.label}</a>
      ))}
      <a href="/contact" class="btn-primary justify-center mt-2">Get a Quote</a>
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
