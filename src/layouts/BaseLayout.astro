---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = 'Web Guy Nick | Websites That Sell for Small Businesses',
  description = 'Conversion-led websites, hosting, SEO, and ongoing maintenance for small businesses. Built by Web Guy Nick LLC.',
  image = '/logo.jpg',
  canonical = Astro.url.href,
  type = 'website',
  noindex = false,
  breadcrumbs,
} = Astro.props;

const siteName = 'Web Guy Nick LLC';

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.url, Astro.site).toString(),
  })),
} : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).toString()} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      '@id': 'https://webguynick.com/#business',
      name: 'Web Guy Nick LLC',
      alternateName: 'Web Guy Nick',
      image: new URL('/logo.jpg', Astro.site).toString(),
      logo: new URL('/logo.jpg', Astro.site).toString(),
      url: 'https://webguynick.com',
      telephone: '+1-951-536-0028',
      email: 'info@webguynick.com',
      description: 'Small business website design, performance engineering, hosting, and ongoing maintenance.',
      areaServed: { '@type': 'Country', name: 'United States' },
      priceRange: '$$',
      founder: { '@type': 'Person', name: 'Nick' },
      knowsAbout: ['Web Design', 'Web Performance', 'SEO', 'WordPress', 'Astro', 'Small Business Websites'],
      sameAs: [
        'https://www.facebook.com/webguynickllc',
        'https://www.instagram.com/webguynickllc',
        'https://www.linkedin.com/company/webguynickllc',
        'https://x.com/webguyeth',
        'https://www.tiktok.com/@webguynick1',
      ],
    })} />
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
