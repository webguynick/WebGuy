---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailchimpForm from '../components/MailchimpForm.astro';

const services = [
  {
    title: 'New Website Build',
    priceFrom: 'from $1,500',
    blurb: 'A complete, conversion-led small-business site — design, copy polish, launch, and 30 days of post-launch support.',
    bullets: [
      'Up to 5 pages, mobile-first',
      'Built on a modern static stack (Astro / 11ty)',
      'Core Web Vitals 90+ at launch',
      'Contact form, analytics, and SEO baseline',
      'Domain + hosting setup',
    ],
  },
  {
    title: 'Performance Tune-Up',
    priceFrom: 'from $500',
    blurb: 'Keep your existing site. Strip the bloat, fix the Core Web Vitals, and actually show up on page one.',
    bullets: [
      'Full Lighthouse + SEO audit',
      'Image + font + JS optimization',
      'Caching & CDN setup',
      'Measurable before/after numbers',
    ],
  },
  {
    title: 'Digital Concierge (Monthly)',
    priceFrom: 'from $149/mo',
    blurb: 'Ongoing care — security patches, backups, content changes, and a quarterly growth review. Predictable, cancel anytime.',
    bullets: [
      'Security patches + uptime monitoring',
      'Daily off-site backups',
      'Up to 1 hour/month of content edits',
      'Quarterly SEO & speed report',
    ],
  },
  {
    title: 'SEO & Content',
    priceFrom: 'from $750/mo',
    blurb: 'Technical SEO, keyword strategy, and one publish-ready article per month written for your customers.',
    bullets: [
      'Technical SEO audit',
      'Monthly long-form article (1,000+ words)',
      'Google Business Profile optimization',
      'Local citations cleanup',
    ],
  },
];
---
<BaseLayout
  title="Services — Web Guy Nick"
  description="Small-business web design, performance tune-ups, monthly maintenance, and SEO from Web Guy Nick LLC."
>
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold text-white md:text-5xl">Services</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      Pick the one that fits. Not sure? <a href="/contact" class="text-brand-accent underline">Tell me what you're working on</a> and I'll point you at the right option — even if it isn't me.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20">
    <div class="grid gap-6 md:grid-cols-2">
      {services.map((s) => (
        <div class="card flex flex-col">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="text-2xl font-semibold text-white">{s.title}</h2>
            <span class="text-sm font-semibold text-brand-accent whitespace-nowrap">{s.priceFrom}</span>
          </div>
          <p class="mt-3 text-slate-300">{s.blurb}</p>
          <ul class="mt-4 space-y-2 text-sm text-slate-300">
            {s.bullets.map((b) => (
              <li class="flex gap-2"><span class="text-brand-accent">✓</span><span>{b}</span></li>
            ))}
          </ul>
          <a href="/contact" class="btn-primary mt-6 self-start">Start this</a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24">
    <MailchimpForm />
  </section>
</BaseLayout>
