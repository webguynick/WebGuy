---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('hosting'))
  .sort((a, b) => b.data.rating - a.data.rating);

function stars(r: number) {
  const full = Math.round(r);
  return '★★★★★☆☆☆☆☆'.slice(5 - full, 10 - full);
}
---
<BaseLayout
  title="Hosting Reviews & Comparison | Web Guy Nick"
  description="Honest reviews of the hosting providers I use for small-business clients. Includes discounted signup links via link.me/webguynick."
>
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold text-white md:text-5xl">Hosting, compared honestly</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      I only list hosts I'd put my own clients on. Signup links route through
      <a href="https://link.me/webguynick" class="text-brand-accent underline">link.me/webguynick</a>, 
      you get the same deal, I earn a small referral. Disclosure on the <a href="/disclosure" class="underline text-brand-accent">affiliate page</a>.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-10">
    <div class="card overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="text-slate-400">
          <tr>
            <th class="py-3 pr-6 font-medium">Host</th>
            <th class="py-3 pr-6 font-medium">Rating</th>
            <th class="py-3 pr-6 font-medium">Starts at</th>
            <th class="py-3 pr-6 font-medium">Best for</th>
            <th class="py-3 font-medium"></th>
          </tr>
        </thead>
        <tbody class="text-slate-200">
          {reviews.map((r) => (
            <tr class="border-t border-white/10">
              <td class="py-3 pr-6 font-semibold">{r.data.name}</td>
              <td class="py-3 pr-6 text-brand-accent">{stars(r.data.rating)} <span class="text-slate-400 ml-1">{r.data.rating.toFixed(1)}</span></td>
              <td class="py-3 pr-6">{r.data.priceFrom}</td>
              <td class="py-3 pr-6">{r.data.bestFor}</td>
              <td class="py-3">
                <a href={`/hosting/${r.slug}`} class="text-brand-accent underline">Read review</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24">
    <div class="grid gap-6 md:grid-cols-2">
      {reviews.map((r) => (
        <article class="card">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-2xl font-semibold text-white">{r.data.name}</h2>
            <span class="text-sm text-brand-accent">{stars(r.data.rating)}</span>
          </div>
          <div class="mt-1 text-sm text-slate-400">{r.data.vendor} · from {r.data.priceFrom}</div>
          <p class="mt-3 text-slate-300">{r.data.bestFor}</p>
          <div class="mt-4 grid gap-3 md:grid-cols-2">
            <div>
              <div class="text-xs font-semibold text-slate-400">Pros</div>
              <ul class="mt-1 space-y-1 text-sm text-slate-200">
                {r.data.pros.map((p) => <li>✓ {p}</li>)}
              </ul>
            </div>
            <div>
              <div class="text-xs font-semibold text-slate-400">Cons</div>
              <ul class="mt-1 space-y-1 text-sm text-slate-200">
                {r.data.cons.map((c) => <li>- {c}</li>)}
              </ul>
            </div>
          </div>
          <div class="mt-5 flex gap-3">
            <a href={r.data.url} rel="nofollow sponsored" class="btn-primary">Visit {r.data.vendor}</a>
            <a href={`/hosting/${r.slug}`} class="btn-ghost">Full review</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
