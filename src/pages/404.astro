---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Web Guy Nick" description="We couldn't find that page." noindex>
  <section class="mx-auto max-w-3xl px-5 pt-24 pb-24 text-center">
    <div class="text-6xl font-extrabold text-brand-accent">404</div>
    <h1 class="mt-4 text-3xl font-bold text-white">That page took a wrong turn.</h1>
    <p class="mt-3 text-slate-300">Try the <a href="/" class="text-brand-accent underline">home page</a> or <a href="/articles" class="text-brand-accent underline">latest articles</a>.</p>
  </section>
</BaseLayout>
