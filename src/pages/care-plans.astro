---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailchimpForm from '../components/MailchimpForm.astro';
import { carePlans, carePlanComparison } from '../data/services';

const faqs = [
  { q: 'Why do I need a care plan if my site is already built?', a: "Because a WordPress site isn't a 'set it and forget it' asset. Plugins push security patches every week. SSL certs expire. Forms break silently. A care plan keeps everything healthy and gives you a real human to call when something does go wrong — at 2am, on a holiday, when a form stops sending leads." },
  { q: "What's the difference between a care plan and managed hosting?", a: "Hosting keeps your site online and fast. A care plan keeps your site healthy and growing. Hosting is the server. Care is the work done on the site: updates, backups, security scans, edits, SEO checks, performance tuning. Most clients have both — I offer a 10% discount when you bundle them." },
  { q: 'Can I cancel anytime?', a: "Yes. All plans are month-to-month with no contracts and no early termination fees. Cancel anytime — you keep your site, your content, and your hosting login." },
  { q: 'Do unused edit hours roll over?', a: "Edit hours roll over one month max, so they don't disappear if you have a quiet month. Beyond that, they reset — this is what keeps the pricing low. Need more hours? Upgrade or add a one-off block at $90/hr." },
  { q: 'What happens if my site gets hacked while on a care plan?', a: "I clean it up at no extra charge as long as the hack happened during your active plan. Premium plan clients also get priority response (same-day) and daily malware scanning, so we usually catch issues before they become incidents." },
  { q: 'Can I switch tiers later?', a: "Anytime. Upgrade or downgrade with one email and the change takes effect on your next billing cycle. Most clients start on Essential or Growth and move up as their site grows." },
  { q: 'Do you work with non-WordPress sites?', a: "I do support custom Astro and other static sites for clients I've built for. For care plans, WordPress is where the structured value lives — but reach out and we can talk about a custom plan." },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceJsonLd = carePlans.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${p.tier} Care Plan`,
  description: p.description,
  provider: { '@type': 'Organization', name: 'Web Guy Nick LLC', url: 'https://webguynick.com' },
  offers: {
    '@type': 'Offer',
    price: p.price,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: p.price,
      priceCurrency: 'USD',
      unitText: 'MON',
      billingDuration: 'P1M',
    },
  },
}));
---
<BaseLayout
  title="Website Care Plans | Web Guy Nick"
  description="Monthly WordPress care plans from $79/mo. Updates, backups, security, edits, SEO checks, and a real human watching over your site. Cancel anytime."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
  {serviceJsonLd.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} slot="head" />
  ))}

  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-white/10">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-32 -left-32 h-[28rem] w-[28rem] rounded-full bg-emerald-400/10 blur-3xl"></div>
      <div class="absolute top-10 right-[-8rem] h-[24rem] w-[24rem] rounded-full bg-brand-blue/15 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-5 py-20 md:py-24">
      <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Care plans</div>
      <h1 class="mt-3 text-4xl font-extrabold text-white md:text-6xl leading-tight">
        Your website,
        <span class="bg-gradient-to-r from-emerald-400 to-brand-accent bg-clip-text text-transparent">fully managed.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300 leading-relaxed">
        WordPress updates, backups, security, edits, SEO checks — handled. Three plans starting at <span class="text-white font-semibold">$79/mo</span>. Month-to-month, cancel anytime.
      </p>
      <div class="mt-8 grid gap-3 max-w-2xl text-sm text-slate-300 sm:grid-cols-3">
        <div class="flex items-center gap-2"><span class="text-emerald-400">✓</span><span>No contracts</span></div>
        <div class="flex items-center gap-2"><span class="text-emerald-400">✓</span><span>No setup fees</span></div>
        <div class="flex items-center gap-2"><span class="text-emerald-400">✓</span><span>Real human, not a ticket queue</span></div>
      </div>
    </div>
  </section>

  <!-- PRICING TIERS -->
  <section class="mx-auto max-w-7xl px-5 py-16">
    <div class="grid gap-6 md:grid-cols-3 items-stretch">
      {carePlans.map((plan) => (
        <article class={`relative flex flex-col rounded-2xl border p-8 transition ${
          plan.featured
            ? 'border-emerald-400/40 bg-gradient-to-b from-emerald-400/[0.07] to-white/[0.02] shadow-[0_0_60px_rgba(16,185,129,0.15)]'
            : 'border-white/10 bg-white/[0.03] hover:border-white/20'
        }`}>
          {plan.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-emerald-400 px-3 py-0.5 text-xs font-bold text-slate-950">Most popular</span>
          )}
          <h3 class="text-2xl font-bold text-white">{plan.tier}</h3>
          <p class="mt-1 text-sm text-slate-400">{plan.tagline}</p>
          <div class="mt-6 flex items-baseline gap-1">
            <span class="text-5xl font-extrabold text-white">${plan.price}</span>
            <span class="text-slate-400 text-sm">/month</span>
          </div>
          <p class="mt-4 text-sm text-slate-300 leading-relaxed">{plan.description}</p>
          <div class="mt-4 text-xs font-semibold uppercase tracking-wider text-slate-500">Best for: <span class="text-slate-300 normal-case font-normal">{plan.bestFor}</span></div>
          <ul class="mt-6 space-y-2.5 text-sm flex-1">
            {plan.features.map((f) => (
              <li class="flex items-start gap-2.5">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0z" clip-rule="evenodd"/></svg>
                <span class="text-slate-200">{f}</span>
              </li>
            ))}
          </ul>
          <a href={`/contact?plan=${plan.slug}`} class={`mt-7 inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-semibold transition ${
            plan.featured
              ? 'bg-emerald-400 text-slate-950 hover:bg-emerald-300'
              : 'border border-white/15 bg-white/5 text-white hover:bg-white/10'
          }`}>{plan.cta} →</a>
        </article>
      ))}
    </div>
    <p class="mt-8 text-center text-sm text-slate-400">All plans month-to-month. Cancel anytime. <a href="/contact" class="text-brand-accent underline underline-offset-4">Need something custom? Let's talk.</a></p>
  </section>

  <!-- COMPARISON TABLE -->
  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-5 py-20">
      <div class="mb-10 max-w-3xl">
        <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Full comparison</div>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Every feature, side by side.</h2>
        <p class="mt-3 text-slate-300">No hidden gotchas. Here's exactly what you get at each tier.</p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-brand-bg">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-white/10 bg-white/[0.04] text-slate-200">
            <tr>
              <th class="px-4 py-4 font-semibold sm:px-6">Feature</th>
              <th class="px-3 py-4 font-semibold text-center min-w-[120px]">Essential<br/><span class="text-xs font-normal text-slate-400">$79/mo</span></th>
              <th class="px-3 py-4 font-semibold text-center min-w-[120px] bg-emerald-400/10 text-emerald-300">Growth<br/><span class="text-xs font-normal text-emerald-400/80">$149/mo</span></th>
              <th class="px-3 py-4 font-semibold text-center min-w-[120px]">Premium<br/><span class="text-xs font-normal text-slate-400">$249/mo</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {carePlanComparison.map((row) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="px-4 py-3 text-slate-300 sm:px-6">{row.feature}</td>
                <td class="px-3 py-3 text-center text-slate-200">{row.essential}</td>
                <td class="px-3 py-3 text-center text-slate-100 bg-emerald-400/5">{row.growth}</td>
                <td class="px-3 py-3 text-center text-slate-200">{row.premium}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 text-center">
        <a href="/contact" class="btn-primary">Talk to me about a plan</a>
      </div>
    </div>
  </section>

  <!-- WHY IT MATTERS -->
  <section class="mx-auto max-w-7xl px-5 py-20">
    <div class="grid gap-8 md:grid-cols-3">
      <div class="card">
        <div class="text-3xl">🛡️</div>
        <h3 class="mt-3 text-xl font-semibold text-white">Security that scales with risk</h3>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">90%+ of WordPress hacks happen on sites with outdated plugins. Care plans patch the holes before they're exploited — and clean up at no extra charge if something slips through.</p>
      </div>
      <div class="card">
        <div class="text-3xl">⚡</div>
        <h3 class="mt-3 text-xl font-semibold text-white">A real human, not a ticket queue</h3>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">When something breaks, you text me. Not a chatbot, not a tier-1 rep reading a script. Same-day response on Growth, 1-hour on Premium.</p>
      </div>
      <div class="card">
        <div class="text-3xl">📈</div>
        <h3 class="mt-3 text-xl font-semibold text-white">Maintenance that grows your site</h3>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed">Growth and Premium plans include real growth work: SEO health checks, performance tuning, content edits, and a quarterly strategy call to map what's next.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-3xl px-5 py-20">
      <div class="mb-10 text-center">
        <div class="text-xs font-semibold uppercase tracking-wider text-emerald-400">FAQ</div>
        <h2 class="mt-3 text-3xl font-bold text-white md:text-4xl">Common questions.</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-white/10 bg-white/[0.02] p-5 open:bg-white/[0.04] transition">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-white list-none">
              <span>{f.q}</span>
              <span class="ml-4 text-brand-accent transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-slate-300 leading-relaxed text-sm">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-4xl px-5 py-20 text-center">
    <h2 class="text-3xl font-bold text-white md:text-4xl">Ready to stop worrying about your site?</h2>
    <p class="mt-4 text-lg text-slate-300">Pick a plan, or message me and we'll figure out which fits. Most clients are on a plan within 48 hours.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact?plan=growth" class="btn-primary">Start Growth — $149/mo</a>
      <a href="/contact" class="btn-ghost">Ask a question first</a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-20">
    <MailchimpForm />
  </section>
</BaseLayout>
