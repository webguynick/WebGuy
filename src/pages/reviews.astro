---
import BaseLayout from '../layouts/BaseLayout.astro';
import MailchimpForm from '../components/MailchimpForm.astro';

type Review = {
  name: string;
  source: 'Trustpilot' | 'Yelp' | 'Google';
  sourceUrl: string;
  rating: number;
  date: string;
  title?: string;
  text: string;
};

const reviews: Review[] = [
  {
    name: 'Septimber J.',
    source: 'Trustpilot',
    sourceUrl: 'https://www.trustpilot.com/review/webguynick.com',
    rating: 5,
    date: 'June 2024',
    title: 'Working with Nick has been awesome!',
    text: "Working with Nick has been awesome!! He's super helpful and always has great ideas for my website.",
  },
  {
    name: 'Dianne C.',
    source: 'Trustpilot',
    sourceUrl: 'https://www.trustpilot.com/review/webguynick.com',
    rating: 5,
    date: 'February 2024',
    title: 'Nick did a great job!',
    text: 'I was having a lot of problems with the content of my website so I had Nick take over maintaining and revamping my site. He did an awesome job! Now I have a site that I am proud to have my clients see. I know he can do the same for you.',
  },
  {
    name: 'Verified Customer',
    source: 'Trustpilot',
    sourceUrl: 'https://www.trustpilot.com/review/webguynick.com',
    rating: 5,
    date: 'April 2024',
    title: 'Nick is a super helpful guy',
    text: "Nick is a super helpful guy. We have a website and Nick has provided invaluable experience. He is very honest and extremely helpful. He was right on time and we hit it off right away. I wanted his help in an area where he was sharing his personal experience, and I never actually bought anything from him — yet he offered service and experience to help me. He has provided excellent service. We believe in giving more than we get, and Nick clearly follows the same principles. If you own a business and need any help, Nick will give the most to help. Just call and see for yourself.",
  },
];

const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);

const sourceColor: Record<string, string> = {
  Trustpilot: 'text-emerald-400',
  Yelp: 'text-red-400',
  Google: 'text-blue-400',
};

const avgRating = (
  reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length
).toFixed(1);
---
<BaseLayout
  title="Client Reviews | Web Guy Nick"
  description="Real reviews from small business owners who have worked with Web Guy Nick LLC on websites, SEO, hosting, and AI tools."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Reviews', url: '/reviews' },
  ]}
>
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-10">
    <h1 class="text-4xl font-extrabold text-white md:text-5xl">Client reviews</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      Real, verified feedback from small business owners on Trustpilot and Yelp.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <div class="flex text-yellow-400 text-2xl tracking-tight">★★★★★</div>
      <span class="text-white font-semibold text-lg">{avgRating}</span>
      <span class="text-slate-400 text-sm">across {reviews.length}+ verified reviews</span>
    </div>
    <div class="mt-4 flex flex-wrap gap-3 text-sm">
      <a
        href="https://www.trustpilot.com/review/webguynick.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-4 py-1.5 text-emerald-300 hover:bg-emerald-400/20 transition"
      >
        ★ Read on Trustpilot
      </a>
      <a
        href="https://www.yelp.com/biz/web-guy-nick-rialto-4"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-red-400/30 bg-red-400/10 px-4 py-1.5 text-red-300 hover:bg-red-400/20 transition"
      >
        ★ Read on Yelp (5.0 ★)
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-10">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {reviews.map((r) => (
        <article class="card flex flex-col">
          <div class="flex items-center justify-between gap-2">
            <div>
              <div class="font-semibold text-white">{r.name}</div>
              <a
                href={r.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`text-xs font-medium mt-0.5 hover:underline ${sourceColor[r.source] ?? 'text-slate-400'}`}
              >
                {r.source} · verified
              </a>
            </div>
            <div class="text-xs text-slate-500">{r.date}</div>
          </div>
          <div class="mt-3 text-yellow-400 tracking-tight text-lg">{stars(r.rating)}</div>
          {r.title && <div class="mt-2 font-semibold text-white">{r.title}</div>}
          <p class="mt-2 text-slate-300 text-sm flex-1">{r.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16">
    <div class="card text-center">
      <h2 class="text-2xl font-bold text-white">More reviews on Yelp</h2>
      <p class="mt-3 text-slate-300 max-w-xl mx-auto">
        Web Guy Nick LLC has a 5.0-star rating on Yelp from local Rialto and Inland Empire small business owners. Read the full reviews directly on our Yelp profile.
      </p>
      <a
        href="https://www.yelp.com/biz/web-guy-nick-rialto-4"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary mt-6 inline-flex"
      >
        View Yelp reviews
      </a>
    </div>
  </section>

  <section class="border-y border-white/10 bg-white/[0.02]">
    <div class="mx-auto max-w-7xl px-5 py-16 text-center">
      <h2 class="text-3xl font-bold text-white">Ready to get results like these?</h2>
      <p class="mt-3 text-slate-300 max-w-xl mx-auto">Free 20-minute audit, no pressure. We talk through your goals and where the easy wins are.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-primary inline-flex">Book a free audit</a>
        <a
          href="https://www.trustpilot.com/evaluate/webguynick.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-md border border-white/15 bg-white/5 px-5 py-2.5 text-white hover:bg-white/10 transition"
        >
          Leave a review
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24">
    <MailchimpForm />
  </section>
</BaseLayout>
