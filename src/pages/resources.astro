---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('resources');
const grouped = items.reduce<Record<string, typeof items>>((acc, item) => {
  (acc[item.data.category] ||= []).push(item);
  return acc;
}, {});

const order: (keyof typeof grouped)[] = ['hardware', 'software', 'tool', 'service', 'book'];
const labels: Record<string, string> = {
  hardware: 'Hardware & Gear',
  software: 'Software',
  tool: 'Tools',
  service: 'Services',
  book: 'Books',
};
---
<BaseLayout
  title="Resources for Small Businesses | Web Guy Nick"
  description="Curated Amazon picks, software, and tools I actually hand to clients. Affiliate tag: webguynick-20."
>
  <section class="mx-auto max-w-7xl px-5 pt-16 pb-8">
    <h1 class="text-4xl font-extrabold text-white md:text-5xl">Resources for small businesses</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      Gear, software, and tools I actually put in front of clients. Amazon links use my affiliate tag
      <code class="rounded bg-white/10 px-1.5 py-0.5 text-brand-accent">webguynick-20</code>, 
      same price for you, small kickback to me.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 space-y-12">
    {order.filter((k) => grouped[k]?.length).map((category) => (
      <div>
        <h2 class="text-2xl font-bold text-white">{labels[category]}</h2>
        <div class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {grouped[category].map((item) => (
            <article class="card flex flex-col">
              <h3 class="text-lg font-semibold text-white">{item.data.title}</h3>
              {item.data.priceFrom && <div class="mt-1 text-sm text-brand-accent">{item.data.priceFrom}</div>}
              <p class="mt-3 text-slate-300 text-sm flex-1">{item.data.description}</p>
              <a
                href={item.data.url}
                rel="nofollow sponsored"
                class="btn-primary mt-4 self-start text-sm px-4 py-2"
              >View on Amazon</a>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
