---
import BaseLayout from '../layouts/BaseLayout.astro';
import MatrixRain from '../components/MatrixRain.astro';

const gameJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Bug Smash — Web Guy Nick Dev Arcade',
  description:
    'A free, fast browser arcade game for tech people. Squash the bugs, fight the incidents, grab the AI copilot, and keep your uptime at 100%. Made by Web Guy Nick LLC.',
  applicationCategory: 'Game',
  operatingSystem: 'Web Browser',
  url: 'https://webguynick.com/game',
  author: { '@type': 'Organization', name: 'Web Guy Nick LLC' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout
  title="Bug Smash 🐛 — The Web Guy Nick Dev Arcade"
  description="A free browser arcade game for tech people. Squash bugs, fight incidents, grab the AI copilot, and keep your uptime at 100%. Built by Web Guy Nick LLC."
>
  <script type="application/ld+json" set:html={JSON.stringify(gameJsonLd)} slot="head" />

  <section class="relative overflow-hidden">
    <MatrixRain />
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 -left-40 h-[36rem] w-[36rem] rounded-full bg-brand-accent/10 blur-3xl"></div>
      <div class="absolute top-20 right-[-10rem] h-[30rem] w-[30rem] rounded-full bg-brand-blue/20 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-5xl px-5 pt-16 pb-10 md:pt-20 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/10 px-3 py-1 text-xs font-semibold text-brand-accent">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-accent opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-accent"></span>
        </span>
        Dev Arcade · 100% free, no signup
      </div>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight text-white md:text-6xl">
        Bug Smash
        <span class="bg-gradient-to-r from-brand-accent via-brand-blue-bright to-brand-accent bg-clip-text text-transparent">🐛💥</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-300">
        Production is on fire and the bugs are escaping. Tap the
        <span class="text-brand-accent">bugs, fires &amp; exploits</span> before they tank your uptime —
        but <span class="text-yellow-400">never tap a shipping rocket</span> 🚀. Grab the
        <span class="text-brand-accent">🤖 AI copilot</span> for backup. How long can you keep prod alive?
      </p>
    </div>
  </section>

  <!-- GAME -->
  <section class="mx-auto max-w-5xl px-5 pb-20">
    <div
      id="game-shell"
      class="relative mx-auto w-full overflow-hidden rounded-2xl border border-white/10 bg-black/60 shadow-[0_0_80px_rgba(59,130,246,0.18)] backdrop-blur-sm"
    >
      <!-- HUD -->
      <div class="pointer-events-none absolute inset-x-0 top-0 z-20 flex items-start justify-between gap-2 p-3 md:p-4">
        <div class="flex flex-col gap-1">
          <div class="rounded-lg border border-white/10 bg-black/50 px-3 py-1.5 backdrop-blur-sm">
            <span class="text-[10px] uppercase tracking-wider text-slate-400">Score</span>
            <div class="flex items-baseline gap-2">
              <span id="hud-score" class="text-xl font-extrabold text-white tabular-nums">0</span>
              <span id="hud-combo" class="text-xs font-bold text-brand-accent opacity-0 transition">x1</span>
            </div>
          </div>
          <div class="rounded-lg border border-white/10 bg-black/50 px-3 py-1 text-[11px] text-slate-400 backdrop-blur-sm">
            Best: <span id="hud-best" class="font-bold text-yellow-400 tabular-nums">0</span>
          </div>
        </div>

        <div class="flex flex-col items-end gap-1">
          <div class="rounded-lg border border-white/10 bg-black/50 px-3 py-1.5 text-right backdrop-blur-sm">
            <span class="text-[10px] uppercase tracking-wider text-slate-400">Uptime</span>
            <div id="hud-uptime" class="text-xl font-extrabold tabular-nums text-emerald-400">100%</div>
          </div>
          <div class="rounded-lg border border-white/10 bg-black/50 px-3 py-1 text-[11px] text-slate-400 backdrop-blur-sm">
            Level <span id="hud-level" class="font-bold text-brand-accent">1</span>
          </div>
        </div>
      </div>

      <!-- Power-up banner -->
      <div
        id="powerup-banner"
        class="pointer-events-none absolute left-1/2 top-16 z-20 -translate-x-1/2 rounded-full border border-brand-accent/40 bg-brand-accent/15 px-4 py-1 text-sm font-bold text-brand-accent opacity-0 backdrop-blur-sm transition"
      ></div>

      <!-- Canvas -->
      <canvas id="game-canvas" class="relative z-10 block w-full touch-none select-none" aria-label="Bug Smash game board"></canvas>

      <!-- START OVERLAY -->
      <div id="overlay-start" class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-5 bg-black/70 px-6 text-center backdrop-blur-sm">
        <div class="text-6xl">🐛</div>
        <h2 class="text-2xl font-bold text-white md:text-3xl">Ready to defend prod?</h2>
        <div class="grid max-w-md grid-cols-2 gap-x-6 gap-y-2 text-left text-sm text-slate-300">
          <div>🐛 Bug <span class="text-emerald-400">+10</span></div>
          <div>🔥 Incident <span class="text-emerald-400">+15</span></div>
          <div>💀 Exploit <span class="text-emerald-400">+25</span></div>
          <div>🚀 <span class="text-red-400">Don't tap!</span></div>
          <div>🤖 AI copilot <span class="text-brand-accent">auto-fix</span></div>
          <div>☕ Coffee <span class="text-brand-accent">slo-mo</span></div>
        </div>
        <button id="btn-start" class="btn-primary text-base">Start game ▸</button>
        <p class="text-xs text-slate-500">Tap / click the targets. Works on mobile too.</p>
      </div>

      <!-- GAME OVER OVERLAY -->
      <div id="overlay-over" class="absolute inset-0 z-30 hidden flex-col items-center justify-center gap-4 bg-black/80 px-6 text-center backdrop-blur-sm">
        <div id="over-emoji" class="text-6xl">💀</div>
        <h2 class="text-3xl font-extrabold text-white">Prod is down.</h2>
        <p id="over-rank" class="text-base font-semibold text-brand-accent"></p>
        <div class="flex items-center gap-8">
          <div>
            <div class="text-[10px] uppercase tracking-wider text-slate-400">Score</div>
            <div id="over-score" class="text-3xl font-extrabold text-white tabular-nums">0</div>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wider text-slate-400">Best</div>
            <div id="over-best" class="text-3xl font-extrabold text-yellow-400 tabular-nums">0</div>
          </div>
        </div>
        <p id="over-quip" class="max-w-sm text-sm text-slate-300"></p>
        <div class="mt-1 flex flex-wrap justify-center gap-3">
          <button id="btn-restart" class="btn-primary text-base">Play again ↻</button>
          <button id="btn-share" class="btn-ghost text-base">Share score</button>
        </div>
        <a href="/contact" class="mt-1 text-xs text-slate-500 underline underline-offset-4 hover:text-brand-accent">
          Real bugs on your real site? I can help →
        </a>
      </div>
    </div>

    <!-- Pitch under the game -->
    <div class="mx-auto mt-10 max-w-2xl text-center">
      <p class="text-slate-400">
        Smashing fake bugs is fun. Letting real ones pile up on your live site isn't.
        <a href="/care-plans" class="text-brand-accent underline underline-offset-4">Care plans</a>
        keep your real-world uptime at 100% — updates, backups, security &amp; speed, handled monthly by a human you can call.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-primary text-sm">Get a free site audit</a>
        <a href="/care-plans" class="btn-ghost text-sm">See care plans</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const canvas = document.getElementById('game-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const shell = document.getElementById('game-shell');

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- DOM refs ----
      const el = {
        score: document.getElementById('hud-score'),
        combo: document.getElementById('hud-combo'),
        best: document.getElementById('hud-best'),
        uptime: document.getElementById('hud-uptime'),
        level: document.getElementById('hud-level'),
        banner: document.getElementById('powerup-banner'),
        overlayStart: document.getElementById('overlay-start'),
        overlayOver: document.getElementById('overlay-over'),
        overScore: document.getElementById('over-score'),
        overBest: document.getElementById('over-best'),
        overRank: document.getElementById('over-rank'),
        overQuip: document.getElementById('over-quip'),
        overEmoji: document.getElementById('over-emoji'),
        btnStart: document.getElementById('btn-start'),
        btnRestart: document.getElementById('btn-restart'),
        btnShare: document.getElementById('btn-share'),
      };

      // ---- Sizing ----
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let W = 0, H = 0;
      function resize() {
        const rect = shell.getBoundingClientRect();
        W = rect.width;
        // 4:3-ish, capped, min height for playability
        H = Math.max(420, Math.min(rect.width * 0.62, 560));
        canvas.style.height = H + 'px';
        canvas.width = Math.floor(W * dpr);
        canvas.height = Math.floor(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      window.addEventListener('resize', () => { resize(); });

      // ---- Audio (tiny WebAudio blips) ----
      let actx = null;
      function audio() {
        if (!actx) {
          try { actx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { actx = false; }
        }
        return actx;
      }
      function beep(freq, dur, type, vol) {
        const a = audio();
        if (!a) return;
        const o = a.createOscillator();
        const g = a.createGain();
        o.type = type || 'square';
        o.frequency.value = freq;
        g.gain.value = vol || 0.06;
        o.connect(g); g.connect(a.destination);
        const t = a.currentTime;
        o.start(t);
        g.gain.exponentialRampToValueAtTime(0.0001, t + (dur || 0.08));
        o.stop(t + (dur || 0.08));
      }

      // ---- Entity config ----
      // good = must be tapped (escaping costs uptime). bad = penalty if tapped.
      const KINDS = {
        bug:     { emoji: '🐛', score: 10, dmg: 6,  good: true,  weight: 42 },
        fire:    { emoji: '🔥', score: 15, dmg: 9,  good: true,  weight: 22 },
        exploit: { emoji: '💀', score: 25, dmg: 14, good: true,  weight: 12, fast: true },
        rocket:  { emoji: '🚀', score: 0,  dmg: 18, good: false, weight: 14 }, // do NOT tap
        copilot: { emoji: '🤖', score: 5,  dmg: 0,  good: true,  weight: 4, power: 'copilot' },
        coffee:  { emoji: '☕', score: 5,  dmg: 0,  good: true,  weight: 4, power: 'coffee' },
        shield:  { emoji: '🛡️', score: 5,  dmg: 0,  good: true,  weight: 3, power: 'shield' },
      };
      const KIND_KEYS = Object.keys(KINDS);
      const TOTAL_WEIGHT = KIND_KEYS.reduce((s, k) => s + KINDS[k].weight, 0);
      function pickKind() {
        let r = Math.random() * TOTAL_WEIGHT;
        for (const k of KIND_KEYS) { r -= KINDS[k].weight; if (r <= 0) return k; }
        return 'bug';
      }

      // ---- State ----
      let state = 'idle'; // idle | playing | over
      let entities = [];
      let particles = [];
      let popups = [];
      let score = 0, uptime = 100, level = 1, combo = 0, maxCombo = 0;
      let spawnTimer = 0, spawnEvery = 900, elapsed = 0;
      let shake = 0, slowmoUntil = 0, copilotUntil = 0;
      let last = 0, raf = 0;

      let best = 0;
      try { best = parseInt(localStorage.getItem('bugsmash_best') || '0', 10) || 0; } catch (e) {}
      el.best.textContent = best;

      function reset() {
        entities = []; particles = []; popups = [];
        score = 0; uptime = 100; level = 1; combo = 0; maxCombo = 0;
        spawnTimer = 0; spawnEvery = 900; elapsed = 0;
        shake = 0; slowmoUntil = 0; copilotUntil = 0;
        updateHUD();
      }

      function updateHUD() {
        el.score.textContent = score;
        el.level.textContent = level;
        el.uptime.textContent = Math.max(0, Math.ceil(uptime)) + '%';
        el.uptime.className =
          'text-xl font-extrabold tabular-nums ' +
          (uptime > 60 ? 'text-emerald-400' : uptime > 30 ? 'text-yellow-400' : 'text-red-400');
        if (combo >= 2) {
          el.combo.textContent = 'x' + combo;
          el.combo.style.opacity = '1';
        } else {
          el.combo.style.opacity = '0';
        }
      }

      function showBanner(text) {
        el.banner.textContent = text;
        el.banner.style.opacity = '1';
        clearTimeout(el.banner._t);
        el.banner._t = setTimeout(() => { el.banner.style.opacity = '0'; }, 1400);
      }

      // ---- Spawning ----
      function spawn() {
        const kind = pickKind();
        const cfg = KINDS[kind];
        const size = (cfg.power ? 46 : 52) + Math.random() * 10;
        const margin = size;
        const x = margin + Math.random() * (W - margin * 2);
        const y = margin + 70 + Math.random() * (H - margin * 2 - 80);
        const speedBase = (cfg.fast ? 70 : 38) + level * 6;
        const ang = Math.random() * Math.PI * 2;
        // lifespan shrinks with level; powerups live a touch longer
        const life = (cfg.power ? 2600 : 2400) - Math.min(1200, level * 90);
        entities.push({
          kind, cfg, x, y, size,
          vx: Math.cos(ang) * speedBase,
          vy: Math.sin(ang) * speedBase,
          born: 0, life, t: 0, scale: 0, dead: false, wob: Math.random() * 6.28,
        });
      }

      // ---- FX ----
      function burst(x, y, color, n) {
        if (reduceMotion) return;
        for (let i = 0; i < n; i++) {
          const a = Math.random() * Math.PI * 2;
          const s = 60 + Math.random() * 200;
          particles.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0.5 + Math.random() * 0.4, t: 0, color, r: 2 + Math.random() * 3 });
        }
      }
      function popup(x, y, text, color) {
        popups.push({ x, y, text, color, t: 0, life: 0.9 });
      }

      // ---- Interaction ----
      function damage(amount) {
        uptime -= amount;
        shake = Math.min(16, shake + amount * 0.8);
        if (uptime <= 0) { uptime = 0; gameOver(); }
      }

      function activatePower(power) {
        const now = performance.now();
        if (power === 'copilot') { copilotUntil = now + 4000; showBanner('🤖 AI copilot online — auto-squashing!'); beep(880, 0.12, 'sine', 0.08); }
        else if (power === 'coffee') { slowmoUntil = now + 4000; showBanner('☕ Caffeine rush — slo-mo!'); beep(660, 0.12, 'sine', 0.08); }
        else if (power === 'shield') { uptime = Math.min(100, uptime + 20); showBanner('🛡️ Firewall patched +20% uptime'); beep(523, 0.12, 'sine', 0.08); }
        updateHUD();
      }

      function squash(e, byCopilot) {
        if (e.dead) return;
        e.dead = true;
        const cfg = e.cfg;
        if (cfg.power) {
          activatePower(cfg.power);
          burst(e.x, e.y, '#60a5fa', 18);
          popup(e.x, e.y, '+' + cfg.score, '#60a5fa');
          score += cfg.score;
        } else {
          combo += 1; maxCombo = Math.max(maxCombo, combo);
          const mult = 1 + Math.floor(combo / 3);
          const gained = cfg.score * mult;
          score += gained;
          burst(e.x, e.y, cfg.emoji === '🔥' ? '#f59e0b' : '#60a5fa', 16);
          popup(e.x, e.y, '+' + gained + (mult > 1 ? ' x' + mult : ''), mult > 1 ? '#facc15' : '#34d399');
          if (!byCopilot) beep(420 + Math.min(600, combo * 25), 0.07, 'square', 0.05);
        }
        updateHUD();
      }

      function hit(px, py) {
        // topmost first
        for (let i = entities.length - 1; i >= 0; i--) {
          const e = entities[i];
          if (e.dead) continue;
          const r = e.size * 0.6 * (e.scale || 1);
          const dx = px - e.x, dy = py - e.y;
          if (dx * dx + dy * dy <= r * r) {
            if (e.cfg.good) {
              squash(e, false);
            } else {
              // tapped a rocket — broke prod
              e.dead = true;
              combo = 0;
              damage(e.cfg.dmg);
              burst(e.x, e.y, '#f87171', 22);
              popup(e.x, e.y, 'BROKE PROD! -' + e.cfg.dmg + '%', '#f87171');
              beep(120, 0.25, 'sawtooth', 0.08);
              updateHUD();
            }
            return true;
          }
        }
        return false;
      }

      function pointer(ev) {
        if (state !== 'playing') return;
        const rect = canvas.getBoundingClientRect();
        const cx = (ev.touches ? ev.touches[0].clientX : ev.clientX) - rect.left;
        const cy = (ev.touches ? ev.touches[0].clientY : ev.clientY) - rect.top;
        hit(cx, cy);
      }
      canvas.addEventListener('mousedown', pointer);
      canvas.addEventListener('touchstart', (e) => { e.preventDefault(); pointer(e); }, { passive: false });

      // ---- Loop ----
      function tick(ts) {
        raf = requestAnimationFrame(tick);
        if (!last) last = ts;
        let dt = (ts - last) / 1000;
        last = ts;
        if (dt > 0.05) dt = 0.05;

        const now = performance.now();
        const slow = now < slowmoUntil ? 0.45 : 1;
        const copilot = now < copilotUntil;

        if (state === 'playing') {
          elapsed += dt * 1000;
          // difficulty ramp
          level = 1 + Math.floor(elapsed / 12000) + Math.floor(score / 250);
          spawnEvery = Math.max(380, 900 - level * 45);

          spawnTimer += dt * 1000;
          const maxOnScreen = 4 + level;
          while (spawnTimer >= spawnEvery && entities.filter((e) => !e.dead).length < maxOnScreen) {
            spawnTimer -= spawnEvery;
            spawn();
          }
        }

        // update entities
        for (const e of entities) {
          if (e.dead) continue;
          e.t += dt * 1000;
          // scale in
          e.scale = Math.min(1, e.scale + dt * 6);
          if (state === 'playing') {
            e.x += e.vx * dt * slow;
            e.y += e.vy * dt * slow;
            const r = e.size * 0.5;
            if (e.x < r) { e.x = r; e.vx = Math.abs(e.vx); }
            if (e.x > W - r) { e.x = W - r; e.vx = -Math.abs(e.vx); }
            if (e.y < r + 60) { e.y = r + 60; e.vy = Math.abs(e.vy); }
            if (e.y > H - r) { e.y = H - r; e.vy = -Math.abs(e.vy); }

            // copilot auto-squashes good non-powerup targets
            if (copilot && e.cfg.good && !e.cfg.power && e.t > 120) {
              squash(e, true);
              continue;
            }
            // expire
            if (e.t >= e.life) {
              e.dead = true;
              if (e.cfg.good && !e.cfg.power) {
                // a bug got away
                combo = 0;
                damage(e.cfg.dmg);
                popup(e.x, e.y, 'escaped! -' + e.cfg.dmg + '%', '#f87171');
                updateHUD();
              }
            }
          }
        }
        entities = entities.filter((e) => !e.dead || (e.scale > 0 && false));
        entities = entities.filter((e) => !e.dead);

        // particles
        for (const p of particles) { p.t += dt; p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 240 * dt; }
        particles = particles.filter((p) => p.t < p.life);
        for (const u of popups) { u.t += dt; u.y -= 36 * dt; }
        popups = popups.filter((u) => u.t < u.life);

        shake *= 0.86;
        render(now, copilot);
      }

      function render(now, copilot) {
        ctx.clearRect(0, 0, W, H);

        // shake
        let ox = 0, oy = 0;
        if (shake > 0.4 && !reduceMotion) { ox = (Math.random() - 0.5) * shake; oy = (Math.random() - 0.5) * shake; }
        ctx.save();
        ctx.translate(ox, oy);

        // faint grid backdrop
        ctx.strokeStyle = 'rgba(96,165,250,0.05)';
        ctx.lineWidth = 1;
        const grid = 40;
        for (let x = 0; x < W; x += grid) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
        for (let y = 0; y < H; y += grid) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }

        // copilot scan glow
        if (copilot && !reduceMotion) {
          ctx.fillStyle = 'rgba(96,165,250,0.05)';
          ctx.fillRect(0, 0, W, H);
        }

        // particles
        for (const p of particles) {
          const a = 1 - p.t / p.life;
          ctx.globalAlpha = Math.max(0, a);
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, 6.2832);
          ctx.fill();
        }
        ctx.globalAlpha = 1;

        // entities
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (const e of entities) {
          const wob = reduceMotion ? 0 : Math.sin(now / 250 + e.wob) * 3;
          const sz = e.size * (e.scale || 1);
          // ring for must-tap urgency near expiry
          if (e.cfg.good && !e.cfg.power && state === 'playing') {
            const frac = 1 - Math.min(1, e.t / e.life);
            ctx.beginPath();
            ctx.arc(e.x, e.y + wob, sz * 0.62, -Math.PI / 2, -Math.PI / 2 + frac * 6.2832);
            ctx.strokeStyle = frac < 0.33 ? 'rgba(248,113,113,0.8)' : 'rgba(96,165,250,0.55)';
            ctx.lineWidth = 3;
            ctx.stroke();
          } else if (e.cfg.power) {
            ctx.beginPath();
            ctx.arc(e.x, e.y + wob, sz * 0.66, 0, 6.2832);
            ctx.strokeStyle = 'rgba(250,204,21,0.7)';
            ctx.lineWidth = 2;
            ctx.setLineDash([4, 4]);
            ctx.stroke();
            ctx.setLineDash([]);
          } else if (!e.cfg.good) {
            // danger halo for rockets
            ctx.fillStyle = 'rgba(248,113,113,0.12)';
            ctx.beginPath();
            ctx.arc(e.x, e.y + wob, sz * 0.7, 0, 6.2832);
            ctx.fill();
          }
          ctx.font = sz + 'px serif';
          ctx.fillText(e.cfg.emoji, e.x, e.y + wob);
        }

        // popups
        for (const u of popups) {
          const a = 1 - u.t / u.life;
          ctx.globalAlpha = Math.max(0, a);
          ctx.fillStyle = u.color;
          ctx.font = 'bold 18px Inter, system-ui, sans-serif';
          ctx.fillText(u.text, u.x, u.y);
        }
        ctx.globalAlpha = 1;

        ctx.restore();
      }

      // ---- Game flow ----
      function start() {
        audio(); // unlock on user gesture
        reset();
        state = 'playing';
        el.overlayStart.style.display = 'none';
        el.overlayOver.style.display = 'none';
        el.overlayOver.classList.add('hidden');
        last = 0;
      }

      const RANKS = [
        { min: 0,    title: 'Intern on call', emoji: '😅', quip: "Hey, everybody starts somewhere. The bugs start somewhere too — usually in prod." },
        { min: 150,  title: 'Junior Dev',     emoji: '🙂', quip: "Solid reflexes. You'd survive a Friday deploy. Probably." },
        { min: 400,  title: 'Senior Dev',     emoji: '😎', quip: "Cool under fire. The on-call pager fears you." },
        { min: 800,  title: 'Staff Engineer', emoji: '🧠', quip: "You don't fix bugs. Bugs apologize and leave." },
        { min: 1500, title: '10x Bug Slayer', emoji: '🔥', quip: "Legendary uptime. Are you... an AI? Be honest." },
      ];
      function rankFor(s) { let r = RANKS[0]; for (const x of RANKS) if (s >= x.min) r = x; return r; }

      function gameOver() {
        state = 'over';
        const isBest = score > best;
        if (isBest) { best = score; try { localStorage.setItem('bugsmash_best', String(best)); } catch (e) {} }
        el.best.textContent = best;
        const r = rankFor(score);
        el.overScore.textContent = score;
        el.overBest.textContent = best;
        el.overEmoji.textContent = r.emoji;
        el.overRank.textContent = (isBest ? '🏆 New best! · ' : '') + r.title;
        el.overQuip.textContent = r.quip + (maxCombo >= 6 ? ' (Top combo: x' + maxCombo + '!)' : '');
        el.overlayOver.style.display = 'flex';
        el.overlayOver.classList.remove('hidden');
        beep(160, 0.4, 'sawtooth', 0.07);
      }

      el.btnStart.addEventListener('click', start);
      el.btnRestart.addEventListener('click', start);
      el.btnShare.addEventListener('click', async function () {
        const r = rankFor(score);
        const text = 'I scored ' + score + ' on Bug Smash 🐛💥 and ranked "' + r.title + '" ' + r.emoji + '. Can you keep prod alive? Play at https://webguynick.com/game';
        try {
          if (navigator.share) { await navigator.share({ title: 'Bug Smash', text, url: 'https://webguynick.com/game' }); }
          else { await navigator.clipboard.writeText(text); this.textContent = 'Copied! ✓'; setTimeout(() => { this.textContent = 'Share score'; }, 1800); }
        } catch (e) {}
      });

      // ---- Boot ----
      resize();
      raf = requestAnimationFrame(tick);
    })();
  </script>
</BaseLayout>
