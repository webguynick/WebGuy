# Copy to .env and fill in. Values prefixed with PUBLIC_ are exposed to the built site.

# Mailchimp embedded-form action URL
# Get from: Mailchimp → Audience → Signup forms → Embedded forms → copy <form action="...">
PUBLIC_MAILCHIMP_ACTION=https://webguynick.us1.list-manage.com/subscribe/post?u=REPLACE_U&id=REPLACE_ID&f_id=REPLACE_F

# Mailchimp honeypot field name (the b_XXX_XXX in the same embed code)
PUBLIC_MAILCHIMP_BOT_NAME=b_REPLACE_U_REPLACE_ID

# Contact form endpoint (Formspree / Basin / Getform)
PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/REPLACE_ME
